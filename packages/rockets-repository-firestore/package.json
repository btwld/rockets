{
  "name": "@concepta/rockets-repository-firestore",
  "version": "1.0.0-alpha.8",
  "description": "Firestore repository adapter for Rockets — implements RepositoryModuleInterface and RepositoryAdapter from @concepta/nestjs-repository",
  "author": "Thiago Ramalho <thiago.ramalho@concepta.com>",
  "license": "BSD-3-Clause",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conceptadev/rockets.git",
    "directory": "packages/rockets-repository-firestore"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist/**/!(*.spec|*.e2e-spec|*.fixture).{js,d.ts}",
    "firestore.indexes.example.json",
    "README.md",
    "LICENSE.txt",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "prepack": "yarn run -T clean && yarn run -T build",
    "build:watch": "tsc -p tsconfig.json --watch",
    "test": "cd ../.. && ./node_modules/.bin/vitest run --project unit packages/rockets-repository-firestore"
  },
  "dependencies": {
    "@concepta/nestjs-core": "8.0.0-alpha.10",
    "@concepta/nestjs-repository": "8.0.0-alpha.10",
    "@concepta/rockets-core": "workspace:^"
  },
  "devDependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "firebase-admin": "^13.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.1",
    "firebase-admin": ">=11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "peerDependenciesMeta": {
    "firebase-admin": {
      "optional": true
    }
  },
  "homepage": "https://github.com/conceptadev/rockets/tree/main/packages/rockets-repository-firestore#readme",
  "bugs": {
    "url": "https://github.com/conceptadev/rockets/issues"
  },
  "keywords": [
    "nestjs",
    "rockets",
    "firestore",
    "repository",
    "firebase",
    "database",
    "typescript",
    "backend"
  ],
  "stableVersion": "0.0.1-dev.0"
}
