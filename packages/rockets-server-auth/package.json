{
  "name": "@concepta/rockets-auth",
  "version": "1.0.0-alpha.8",
  "description": "Rockets Auth - JWT authentication, account recovery, OTP, invitations, and role-based access control for NestJS",
  "author": "Thiago Ramalho <thiago.ramalho@concepta.com>",
  "license": "BSD-3-Clause",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conceptadev/rockets.git",
    "directory": "packages/rockets-server-auth"
  },
  "bugs": {
    "url": "https://github.com/conceptadev/rockets/issues"
  },
  "homepage": "https://github.com/conceptadev/rockets/tree/main/packages/rockets-server-auth#readme",
  "keywords": [
    "nestjs",
    "rockets",
    "authentication",
    "authorization",
    "jwt",
    "passport",
    "rbac",
    "role-based-access-control",
    "otp",
    "2fa",
    "invitation",
    "security",
    "api",
    "backend",
    "typescript"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist/**/!(*.spec|*.e2e-spec|*.fixture).{js,d.ts}",
    "README.md",
    "LICENSE.txt",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "prepack": "yarn run -T clean && yarn run -T build",
    "build:watch": "tsc -p tsconfig.json --watch",
    "test": "cd ../.. && ./node_modules/.bin/vitest run --project unit packages/rockets-server-auth",
    "test:watch": "cd ../.. && ./node_modules/.bin/vitest --project unit packages/rockets-server-auth",
    "test:e2e": "cd ../.. && ./node_modules/.bin/vitest run --project e2e-packages packages/rockets-server-auth",
    "test:e2e:cov": "cd ../.. && ./node_modules/.bin/vitest run --project e2e-packages --coverage packages/rockets-server-auth",
    "test:cov": "cd ../.. && ./node_modules/.bin/vitest run --project unit --coverage packages/rockets-server-auth"
  },
  "dependencies": {
    "@concepta/nestjs-access-control": "8.0.0-alpha.10",
    "@concepta/nestjs-authentication": "8.0.0-alpha.10",
    "@concepta/nestjs-core": "8.0.0-alpha.10",
    "@concepta/nestjs-crud": "8.0.0-alpha.10",
    "@concepta/nestjs-email": "7.0.0-alpha.10",
    "@concepta/nestjs-event": "7.0.0-alpha.10",
    "@concepta/nestjs-federated": "8.0.0-alpha.10",
    "@concepta/nestjs-invitation": "8.0.0-alpha.10",
    "@concepta/nestjs-otp": "8.0.0-alpha.10",
    "@concepta/nestjs-password": "8.0.0-alpha.10",
    "@concepta/nestjs-repository": "8.0.0-alpha.10",
    "@concepta/nestjs-role": "8.0.0-alpha.10",
    "@concepta/nestjs-user": "8.0.0-alpha.10",
    "@concepta/rockets-core": "workspace:^",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/cqrs": "^12.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/swagger": "12.0.1",
    "@types/express": "^4.17.21",
    "@types/passport-jwt": "^3.0.13",
    "@types/passport-strategy": "^0.2.38",
    "accesscontrol": "^2.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-strategy": "^1.0.0",
    "reflect-metadata": "^0.1.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@concepta/rockets": "workspace:^",
    "@concepta/rockets-repository-typeorm": "workspace:^",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "@types/jsonwebtoken": "9.0.6",
    "@types/supertest": "^6.0.2",
    "express-serve-static-core": "^0.1.1",
    "sqlite3": "^5.1.4",
    "supertest": "^6.3.4",
    "typeorm": "^0.3.31",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "rxjs": "^7.1.0"
  },
  "stableVersion": "0.0.1-dev.0"
}
