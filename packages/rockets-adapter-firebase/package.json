{
  "name": "@concepta/rockets-adapter-firebase",
  "version": "1.0.0-alpha.8",
  "description": "Firebase Authentication adapter for Rockets — implements AuthAdapterInterface from @concepta/rockets-core, validates Firebase ID tokens, maps to AuthorizedUser",
  "author": "Thiago Ramalho <thiago.ramalho@concepta.com>",
  "license": "BSD-3-Clause",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conceptadev/rockets.git",
    "directory": "packages/rockets-adapter-firebase"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist/**/!(*.spec|*.e2e-spec|*.fixture).{js,d.ts}",
    "README.md",
    "LICENSE.txt",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "prepack": "yarn run -T clean && yarn run -T build",
    "build:watch": "tsc -p tsconfig.json --watch",
    "test": "cd ../.. && ./node_modules/.bin/vitest run --project unit packages/rockets-adapter-firebase"
  },
  "dependencies": {
    "@concepta/rockets-core": "workspace:^",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/supertest": "^6.0.2",
    "firebase-admin": "^12.0.0",
    "supertest": "^6.3.4",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "firebase-admin": ">=11.0.0"
  },
  "peerDependenciesMeta": {
    "firebase-admin": {
      "optional": true
    }
  },
  "homepage": "https://github.com/conceptadev/rockets/tree/main/packages/rockets-adapter-firebase#readme",
  "bugs": {
    "url": "https://github.com/conceptadev/rockets/issues"
  },
  "keywords": [
    "nestjs",
    "rockets",
    "firebase",
    "authentication",
    "auth-adapter",
    "firebase-admin",
    "typescript",
    "backend"
  ],
  "stableVersion": "0.0.1-dev.0"
}
