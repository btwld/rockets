{
  "name": "sample-server",
  "private": true,
  "version": "0.0.1-dev.0",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "build": "tsc -p tsconfig.json",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "contract:build": "cd ../.. && yarn build && yarn sample:build",
    "contract:export": "yarn contract:build && CONTRACT_UPDATE=1 vitest run --config vitest.e2e.config.mts test/openapi-contract-export.e2e-spec.ts",
    "contract:check": "yarn contract:build && vitest run --config vitest.e2e.config.mts test/openapi-contract-export.e2e-spec.ts"
  },
  "dependencies": {
    "@concepta/nestjs-core": "8.0.0-alpha.10",
    "@concepta/nestjs-crud": "8.0.0-alpha.10",
    "@concepta/nestjs-repository": "8.0.0-alpha.10",
    "@concepta/rockets": "workspace:^",
    "@concepta/rockets-core": "workspace:^",
    "@concepta/rockets-repository-typeorm": "workspace:^",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/cqrs": "12.0.0",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/typeorm": "12.0.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@swc/core": "^1.15.47",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/node": "^20.19.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^6.3.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.0",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  },
  "resolutions": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "glob": "10.5.0",
    "js-yaml": "4.1.1",
    "jws": "3.2.3",
    "multer": "2.0.2",
    "path-to-regexp": "8.3.0",
    "qs": "6.14.1",
    "tar": "7.5.2",
    "validator": "13.15.22"
  }
}
